{
  "openapi": "3.0.3",
  "info": {
    "title": "Book Discovery API",
    "version": "1.0.0",
    "description": "Open Library의 공개 API 일부를 노출하는 실습용 OpenAPI 스펙. 책 검색, 작품 상세 조회, 주제별 추천을 제공한다."
  },
  "servers": [
    { "url": "https://openlibrary.org" }
  ],
  "paths": {
    "/search.json": {
      "get": {
        "operationId": "searchBooks",
        "summary": "제목/저자/키워드로 책 검색",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "검색어 (제목, 저자, 키워드 등)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 5 },
            "description": "반환할 결과 개수"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "key,title,author_name,first_publish_year,cover_i,edition_count"
            },
            "description": "응답에 포함할 필드 목록 (쉼표로 구분)"
          }
        ],
        "responses": {
          "200": {
            "description": "검색 결과 목록. Open Library는 항상 HTTP 200을 반환하며, 결과가 없으면 docs가 빈 배열이다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "numFound": { "type": "integer", "description": "전체 검색 결과 수" },
                    "docs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": { "type": "string", "description": "작품 키, 예: /works/OL893414W" },
                          "title": { "type": "string" },
                          "author_name": { "type": "array", "items": { "type": "string" } },
                          "first_publish_year": { "type": "integer" },
                          "edition_count": { "type": "integer" }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "네트워크 오류 등 예기치 못한 오류",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/works/{olid}.json": {
      "get": {
        "operationId": "getWorkDetails",
        "summary": "OLID로 작품 상세 정보 조회 (줄거리, 저자, 표지 등)",
        "parameters": [
          {
            "name": "olid",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "작품 OLID. 예: OL893414W (searchBooks 결과의 key 필드에서 /works/ 다음 부분)"
          }
        ],
        "responses": {
          "200": {
            "description": "작품 상세 정보",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "title": { "type": "string" },
                    "key": { "type": "string" },
                    "description": {
                      "description": "줄거리. 문자열이거나 {type, value} 객체 형태로 올 수 있다.",
                      "oneOf": [
                        { "type": "string" },
                        { "type": "object", "properties": { "value": { "type": "string" } }, "additionalProperties": true }
                      ]
                    },
                    "covers": { "type": "array", "items": { "type": "integer" } },
                    "subjects": { "type": "array", "items": { "type": "string" } }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "해당 OLID의 작품이 존재하지 않음. 실제 응답 예: {\"error\":\"notfound\",\"key\":\"/works/OL999999999W\"}",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          },
          "default": {
            "description": "그 외 오류",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    },
    "/subjects/{subject}.json": {
      "get": {
        "operationId": "recommendBySubject",
        "summary": "주제(장르)별 추천 도서 목록 조회",
        "parameters": [
          {
            "name": "subject",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "주제 slug. 예: science_fiction, mystery, romance, fantasy"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 5 },
            "description": "반환할 책 개수"
          }
        ],
        "responses": {
          "200": {
            "description": "주제별 추천 도서 목록. 존재하지 않는 subject라도 HTTP 200과 함께 work_count=0, works=[]를 반환한다.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": { "type": "string" },
                    "name": { "type": "string" },
                    "work_count": { "type": "integer" },
                    "works": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "key": { "type": "string" },
                          "title": { "type": "string" },
                          "cover_id": { "type": "integer" },
                          "edition_count": { "type": "integer" }
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "description": "네트워크 오류 등 예기치 못한 오류",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "description": "server.js가 HTTP 오류(!response.ok)를 만났을 때 구성해 돌려주는 구조화된 오류 형태",
        "properties": {
          "error": { "type": "string", "description": "HTTP statusText 또는 'HTTP {status}'" },
          "status": { "type": "integer", "description": "HTTP 상태 코드" },
          "detail": { "description": "원본 응답 본문. JSON으로 파싱 가능하면 객체, 아니면 문자열" }
        },
        "required": ["error", "status"]
      }
    }
  }
}
